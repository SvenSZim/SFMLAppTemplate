# Formatting for all C++ in this repository. See docs/CODE_STYLE.md.
Language: Cpp
BasedOnStyle: LLVM
Standard: c++20

IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 120

# Braces on the same line, also for functions, classes and namespaces
BreakBeforeBraces: Attach
NamespaceIndentation: None
AccessModifierOffset: -4
IndentCaseLabels: true

# T& x, T* x
PointerAlignment: Left
DerivePointerAlignment: false

# Constructor(Args) :
#     m_a(a),
#     m_b(b)
BreakConstructorInitializers: AfterColon
PackConstructorInitializers: Never
ConstructorInitializerIndentWidth: 4

AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Empty
AllowShortLambdasOnASingleLine: All
AlwaysBreakTemplateDeclarations: Yes
BinPackArguments: false
BinPackParameters: false
AlignAfterOpenBracket: BlockIndent
SpaceAfterTemplateKeyword: true
# Block style for braced lists. It is the only setting that keeps the setup syntax readable:
#     .widgets = {
#         Slider("Speed", params.speed, {.min = 0, .max = 10}),
#     },
# With the other styles, clang-format breaks after `.widgets =` as soon as an entry has an options
# list of its own. The price is a space inside the braces of plain lists: `{ 1280, 720 }`.
Cpp11BracedListStyle: false
InsertNewlineAtEOF: true
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1

# Include order: own header (automatic), project, SFML, other libraries, standard library
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"atpl/'
    Priority: 1
  - Regex: '^"'
    Priority: 2
  - Regex: '^<SFML/'
    Priority: 3
  - Regex: '^<.*\.(h|hpp)>'
    Priority: 4
  - Regex: '^<'
    Priority: 5
